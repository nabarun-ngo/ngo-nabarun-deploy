{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "$comment": [
    "NestJS API deployed to Google App Engine.",
    "Single-app repository: install and build run at the repository root.",
    "DATABASE_URL in the build command only lets Prisma load prisma.config.ts during generate.",
    "Migration and runtime use the Doppler database URL."
  ],
  "apiVersion": "deploy.platform/v1",
  "kind": "Application",
  "metadata": {
    "name": "backend-api",
    "description": "NestJS API deployed to Google App Engine.",
    "labels": {
      "team": "platform",
      "tier": "backend"
    }
  },
  "source": {
    "repository": "nabarun-ngo/ngo-nabarun-be",
    "buildRoot": "."
  },
  "build": {
    "runtime": "node",
    "nodeVersion": "24",
    "install": "npm ci",
    "command": "DATABASE_URL=demo npm run build",
    "outputPath": "dist",
    "bundleIncludes": ["prisma", "prisma.config.ts"]
  },
  "deploy": {
    "platform": "gae",
    "configTemplate": "config/platforms/gae/app.yaml.tpl",
    "serviceKey": "gaeService",
    "secrets": {
      "provider": "doppler",
      "project": "backend-api",
      "bundleCli": true
    }
  },
  "database": {
    "migrate": true,
    "command": "npm run migrate:deploy && npm run seed"
  },
  "healthCheck": {
    "enabled": true,
    "path": "/health",
    "timeoutSeconds": 120
  },
  "environments": {
    "stage": {
      "sourceRef": "develop",
      "gaeService": "api-staging",
      "secrets": { "config": "stg" }
    },
    "prod": {
      "sourceRef": "main",
      "gaeService": "api",
      "secrets": { "config": "prd" }
    }
  }
}
