{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deploy.platform/schemas/schedules.v1.schema.json",
  "title": "SchedulesConfig",
  "description": "Schema for config/schedules/*.json — defines scheduled and dispatch-triggered test runs.",
  "type": "object",
  "required": ["schedules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Schedule"
      }
    }
  },
  "definitions": {
    "Schedule": {
      "type": "object",
      "required": ["id", "profile", "githubEnvironment"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique kebab-case identifier for this schedule."
        },
        "description": {
          "type": "string",
          "description": "Human-readable purpose of this schedule."
        },
        "cron": {
          "type": "string",
          "description": "Unix cron expression (5 fields). Required when trigger is not set.",
          "pattern": "^(\\*|[0-9,\\-/]+) (\\*|[0-9,\\-/]+) (\\*|[0-9,\\-/]+) (\\*|[0-9,\\-/]+) (\\*|[0-9,\\-/]+)$"
        },
        "trigger": {
          "type": "string",
          "description": "GitHub event type that activates this schedule instead of cron.",
          "enum": ["repository_dispatch"]
        },
        "eventType": {
          "type": "string",
          "description": "repository_dispatch client payload event type. Required when trigger == repository_dispatch."
        },
        "profile": {
          "$ref": "#/definitions/TestProfile"
        },
        "githubEnvironment": {
          "type": "string",
          "description": "GitHub Environment name used to scope secrets for this run (e.g. tests-scheduled)."
        }
      },
      "oneOf": [
        { "required": ["cron"], "not": { "required": ["trigger"] } },
        { "required": ["trigger", "eventType"], "not": { "required": ["cron"] } }
      ]
    },
    "TestProfile": {
      "type": "object",
      "required": ["tags", "environment"],
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "string",
          "description": "Cucumber tag expression used to filter which scenarios run (e.g. @smoke)."
        },
        "environment": {
          "type": "string",
          "description": "Logical target environment for the test run (e.g. stage, prod).",
          "enum": ["stage", "prod"]
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1,
          "description": "Number of parallel Maven/Cucumber shards."
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360,
          "default": 60,
          "description": "Per-shard job timeout in minutes."
        }
      }
    }
  }
}
